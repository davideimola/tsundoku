# macOS
.DS_Store

# Secrets and local configuration. `DATABASE_URL` lives in .env.local; never
# committed. See .env.example for the shape.
.env
.env.*
!.env.example

# The owner's own export of the two sheets. It is their reading history and their
# receipts, it is read once by `pnpm import:sheets`, and it is never committed. The fixtures in
# db/import/fixtures are committed and are what the import is rehearsed against.
/db/import/sheets/

# Node deps and Next build output.
/node_modules/
/.next/
/out/
/coverage/
next-env.d.ts
*.tsbuildinfo

# Worktrees. One slice per worktree, at <repo>/.claude/worktrees/<slug>,
# following `pantry`.
.claude/worktrees/

# Node deps, wherever they are (a worktree has its own).
node_modules/
